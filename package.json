{
  "name": "c8y-realtime",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "A Web API compatible real-time client for Cumulocity IoT with hook-based event subscriptions",
  "keywords": [
    "cumulocity",
    "realtime",
    "websocket",
    "iot",
    "notifications",
    "typescript"
  ],
  "license": "MIT",
  "author": "schplitt",
  "homepage": "https://github.com/schplitt/c8y-realtime#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/schplitt/c8y-realtime.git"
  },
  "bugs": {
    "url": "https://github.com/schplitt/c8y-realtime/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "prerelease": "eslint && tsc --noEmit && vitest run && tsdown",
    "release": "bumpp",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "hookable": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@schplitt/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
